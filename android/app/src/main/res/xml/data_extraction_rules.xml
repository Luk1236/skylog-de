<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Die App-Daten nicht in die Google-Kontosicherung aufnehmen.
     Ein Block für den lokalen Gerätewechsel fehlt bewusst: Beim Wechsel auf
     ein neues Gerät darf Android die Daten weiterhin übertragen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
